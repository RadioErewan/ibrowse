  "sourceLanguage": "en",
  "strings": {
    "NSPhotoLibraryUsageDescription": {
      "comment": "Photo library permission prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightbrary reads your photo library so you can browse, rate and delete your photos. Nothing leaves this device."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightbrary czyta bibliotekę zdjęć, żeby pozwolić Ci je przeglądać, oceniać i usuwać. Nic nie opuszcza tego urządzenia."
          }
        }
      }
    }
  },
  "version": "1.0"
}
