{
  "sourceLanguage": "en",
  "strings": {
    "NSPhotoLibraryUsageDescription": {
      "comment": "Photo library permission prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightbrary reads your photo library so you can browse, rate and delete your photos, and adds the photos you choose to import from a folder on your disk. Nothing leaves this Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightbrary czyta bibliotekę zdjęć, żeby pozwolić Ci je przeglądać, oceniać i usuwać, i dodaje do niej zdjęcia, które zaimportujesz z folderu na dysku. Nic nie opuszcza tego Maca."
          }
        }
      }
    }
  },
  "version": "1.0"
}
