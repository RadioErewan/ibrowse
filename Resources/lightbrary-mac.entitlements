<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime odcina dostęp do zasobów osobistych, dopóki program
         nie poprosi o nie w podpisie. Bez tego klucza system odmawia dostępu
         do biblioteki zdjęć **natychmiast i bez pytania**, a aplikacja nie
         pojawia się nawet na liście w Ustawieniach → Prywatność → Zdjęcia.
         Kompilacja deweloperska działa bez niego, bo tam hardened runtime
         jest wyłączony — dlatego usterka wychodzi dopiero na obcym Macu. -->
    <key>com.apple.security.personal-information.photos-library</key>
    <true/>
</dict>
</plist>
